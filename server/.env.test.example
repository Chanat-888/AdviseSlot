# Copy to .env.test. Tests use their own database in the same Docker container,
# so they never touch the development data. Its name must end in _test.
DATABASE_URL="postgresql://adviseslot:adviseslot_dev@localhost:5433/adviseslot_test?schema=public"
NODE_ENV=test
APP_TIMEZONE=Asia/Bangkok
# Test-only demo password. The tests and the E2E journey log in with it.
SEED_DEMO_PASSWORD=test-demo-password
