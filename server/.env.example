# Copy to .env. These values match the local Docker database in docker-compose.yml,
# which is for development only. Production values live in GCP Secret Manager.
DATABASE_URL="postgresql://adviseslot:adviseslot_dev@localhost:5433/adviseslot?schema=public"
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
APP_TIMEZONE=Asia/Bangkok
# Password for the seeded demo accounts (README "Setup"). Pick your own, 12+ characters.
# Local development only. For a deployed database, use a secret and a different value.
SEED_DEMO_PASSWORD=change-me-local-demo
# Optional, production only: where Express reads the built client from.
# Default ../client/dist relative to server/dist (the Docker image uses the default).
# CLIENT_DIST=/app/client/dist
